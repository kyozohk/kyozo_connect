rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Lock down all documents by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Allow users to read and write to their own user document
    match /users/{userId} {
      allow read, write: if request.auth.uid == userId;
    }

    // Communities can be read by anyone, but only created/updated/deleted by authenticated users.
    match /communities/{communityId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;

      // Messages can be created by any authenticated user.
      // Reading/updating/deleting messages is restricted.
      match /messages/{messageId} {
        allow create: if request.auth != null;
        allow read, update, delete: if request.auth != null; // Further restrict if needed (e.g., to members)
      }
    }

    // Memberships can be created by authenticated users.
    // Reading/updating/deleting should be restricted based on roles.
    match /memberships/{membershipId} {
      allow create: if request.auth != null;
      allow read, update, delete: if request.auth != null; // Further restrict if needed (e.g., to community owners/admins)
    }
  }
}
