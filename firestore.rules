
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Rules for the 'users' collection
    match /users/{userId} {
      // Allow users to read their own document
      allow read: if isSignedIn() && isOwner(userId);
      // Allow users to create their own document
      allow create: if isSignedIn() && isOwner(userId);
      // Allow users to update their own document
      allow update: if isSignedIn() && isOwner(userId);
      // Disallow deleting user documents for now
      allow delete: if false;
    }

    // Rules for the 'communities' collection
    match /communities/{communityId} {
      // Anyone can read community data
      allow read: if true;
      // Logged-in users can create communities
      allow create: if isSignedIn();
      // Only the owner can update the community
      allow update: if isSignedIn() && get(/databases/$(database)/documents/memberships/$(request.auth.uid)_$(communityId)).data.role == 'owner';
      // Only the owner can delete the community
      allow delete: if isSignedIn() && get(/databases/$(database)/documents/memberships/$(request.auth.uid)_$(communityId)).data.role == 'owner';

      // Rules for 'messages' subcollection
      match /messages/{messageId} {
        // Any member of the community can read messages
        allow read: if isSignedIn() && exists(/databases/$(database)/documents/memberships/$(request.auth.uid)_$(communityId));
        // Any member of the community can create messages
        allow create: if isSignedIn() && exists(/databases/$(database)/documents/memberships/$(request.auth.uid)_$(communityId));
        // Generally, users should not be able to update or delete messages, but this can be adjusted
        allow update, delete: if false;
      }
    }

    // Rules for the 'memberships' collection
    match /memberships/{membershipId} {
        // Members can read their own membership
        allow read: if isSignedIn() && request.auth.uid == resource.data.userId;
        // Community owners/admins can create new memberships
        allow create: if isSignedIn() && get(/databases/$(database)/documents/memberships/$(request.auth.uid)_$(resource.data.communityId)).data.role in ['owner', 'admin'];
        // Members can't change their own role, but owners/admins can
        allow update: if isSignedIn() && get(/databases/$(database)/documents/memberships/$(request.auth.uid)_$(resource.data.communityId)).data.role in ['owner', 'admin'];
        // Owners/admins can remove members. Members can leave a community.
        allow delete: if isSignedIn() && 
                    (get(/databases/$(database)/documents/memberships/$(request.auth.uid)_$(resource.data.communityId)).data.role in ['owner', 'admin'] || 
                    request.auth.uid == resource.data.userId);
    }
  }
}
